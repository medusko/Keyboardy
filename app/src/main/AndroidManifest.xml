<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app_option_1"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_option_1"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyboardy"
        android:usesCleartextTraffic="true">

        <!-- Setup, Settings & Live Chat Sandbox Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6 Selectable App Icon Aliases -->
        <activity-alias
            android:name=".IconAlias1"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_app_option_1"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_app_option_1"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAlias2"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_app_option_2"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_app_option_2"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAlias3"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_app_option_3"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_app_option_3"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAlias4"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_app_option_4"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_app_option_4"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAlias5"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_app_option_5"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_app_option_5"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAlias6"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_app_option_6"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_app_option_6"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Auxiliary Image & GIF Search Keyboard Service -->
        <service
            android:name=".ime.KeyboardyImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Secure FileProvider for CommitContent API (Android 7.1+) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
