<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_screen_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_bg"
    android:orientation="vertical">

    <!-- Top App Bar (Matching Lagatron's TopAppBar: Title + Status Pill + Info Icon + Light/Dark Icon) -->
    <LinearLayout
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp">

        <!-- Title + Status Badge Row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Keyboardy"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Lagatron-style Status Pill (ENABLED / SETUP) -->
            <LinearLayout
                android:id="@+id/status_pill_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp">

                <View
                    android:id="@+id/status_pill_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp" />

                <TextView
                    android:id="@+id/tv_status_pill_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ENABLED"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Info Button (About Keyboardy Dialog) -->
        <ImageButton
            android:id="@+id/btn_about_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="About Keyboardy"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info" />

        <!-- Light / Dark Theme Icon Button (Sun in Dark Mode, Moon in Light Mode — matching Lagatron) -->
        <ImageButton
            android:id="@+id/btn_toggle_theme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Light/Dark Theme"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_light_mode" />
    </LinearLayout>

    <!-- Thin TopAppBar Divider -->
    <View
        android:id="@+id/top_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E3342" />

    <ScrollView
        android:id="@+id/root_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="36dp">

            <!-- Card 1: Setup & Switch Auxiliary Keyboard -->
            <LinearLayout
                android:id="@+id/card_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_ime_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auxiliary Keyboard Setup"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_setup_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Keep Gboard as your main keyboard! Switch to Keyboardy whenever you want to search full-screen and drop an image or GIF directly into a conversation."
                    android:textColor="#B8C2D4"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_enable_ime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:backgroundTint="#2E6BD9"
                        android:text="1. Enable in Settings"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_switch_ime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#222631"
                        android:text="2. Switch Keyboard"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Keyboard Scale & Bottom Bar Clearance -->
            <LinearLayout
                android:id="@+id/card_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_scale_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keyboard Size &amp; Bottom Bar Clearance"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_scale_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Scale up the typing keys while the image results automatically fill the rest of the screen. Changes apply live!"
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <!-- 4 Scale Option Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_scale_compact"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="100%"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_scale_normal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="115%"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_scale_large"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="130%"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_scale_xlarge"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="145% XL"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Bottom Navigation Clearance Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_bottom_clearance_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bottom Bar Offset: 54dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_clearance_minus"
                        android:layout_width="44dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="− 6"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_clearance_plus"
                        android:layout_width="44dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="+ 6"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Live Chat Test Sandbox -->
            <LinearLayout
                android:id="@+id/card_sandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_sandbox_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Chat Test Sandbox"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sandbox_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap the input box below, switch to Keyboardy, search &amp; tap an image. It will insert right here via Android's CommitContent API!"
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/sandbox_received_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_sandbox_received"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:contentDescription="Inserted Image"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tv_sandbox_received_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Inserted via commitContent!"
                        android:textColor="#00C853"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_chat_sandbox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:hint="Tap here to test Keyboardy..."
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Card 4: Behavior, Image Badge Legend & Search Engine Preferences -->
            <LinearLayout
                android:id="@+id/card_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_settings_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Behavior &amp; Image Badges"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cb_auto_return_gboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Auto-switch back to Gboard after inserting image"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_auto_read_chat_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Use written chat text as auto-search when opening Keyboardy (Off = every search starts blank)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <!-- Legend explaining the Thunderbolt (⚡), Google (G), and GIF badges -->
                <LinearLayout
                    android:id="@+id/badge_legend_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_badge_legend_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What the Image Badges Mean:"
                        android:textColor="#2E6BD9"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_badge_legend_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:text="• ⚡ (Thunderbolt): Fetched via Instant Web Search — ultra-fast async HTTP engine that returns high-res images and GIFs in ~150ms.\n• G (Google): Fetched via Headless Google Images — an invisible background WebView querying Google Images directly.\n• GIF: Indicates an animated GIF that loops in the preview grid and inserts as an animation."
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_api_key_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Optional: Brave Search or SerpApi Key (Leave blank for 100% Free Hybrid Google + Instant Search)"
                    android:textColor="#B8C2D4"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_optional_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:hint="Optional SerpApi or Brave API Key (Not required)"
                    android:inputType="textNoSuggestions"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_save_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2E6BD9"
                    android:text="Save Preferences"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
