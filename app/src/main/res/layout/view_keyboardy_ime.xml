<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_ime_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_bg"
    android:orientation="vertical">

    <!-- Top Boundary Line & App Return Indicator (clearly denotes boundary to scroll/tap back into host app) -->
    <LinearLayout
        android:id="@+id/ime_top_boundary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:id="@+id/ime_top_line"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/kb_accent" />
    </LinearLayout>

    <!-- Top Bar: Return to Gboard + Interactive Search Bar + History Button + Settings Button -->
    <LinearLayout
        android:id="@+id/top_bar_container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <!-- Return to Previous Keyboard (Gboard) -->
        <LinearLayout
            android:id="@+id/btn_back_keyboard"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_key_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iv_back_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Back to previous keyboard"
                android:src="@drawable/ic_back_keyboard" />

            <TextView
                android:id="@+id/tv_back_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="ABC"
                android:textColor="@color/kb_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Interactive Search Bar with Blinking Cursor & Text Selection -->
        <LinearLayout
            android:id="@+id/search_bar_container"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />

            <com.medusko.keyboardy.ime.ImeSearchEditText
                android:id="@+id/et_search_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:hint="Search Google Images &amp; GIFs..."
                android:maxLines="1"
                android:paddingVertical="0dp"
                android:singleLine="true"
                android:textColor="@color/kb_text_primary"
                android:textColorHint="@color/kb_text_secondary"
                android:textSize="14.5sp" />

            <ProgressBar
                android:id="@+id/progress_searching"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:indeterminateTint="@color/kb_accent"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btn_clear_query"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear search"
                android:padding="3dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Search History Button -->
        <LinearLayout
            android:id="@+id/btn_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_key_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_history_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search History"
                android:src="@drawable/ic_history" />
        </LinearLayout>

        <!-- Settings Button (Gear icon to open Keyboardy Settings) -->
        <LinearLayout
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_key_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_settings_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Keyboardy Settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- Copy / Cut / Paste / Select All Context Bar (Appears on Long-Press or Text Selection in Search Bar) -->
    <LinearLayout
        android:id="@+id/selection_action_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_ctx_paste"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📋 Paste"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ctx_copy"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="📄 Copy"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ctx_cut"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✂️ Cut"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_ctx_select_all"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Select All"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Filter Chips & Search Engine Selector Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/chip_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="All Images"
                android:textColor="@color/kb_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_gif"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="GIFs"
                android:textColor="@color/kb_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_meme"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Memes"
                android:textColor="@color/kb_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_reaction"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Reactions"
                android:textColor="@color/kb_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chip_filter_sticker"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Transparent"
                android:textColor="@color/kb_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Engine Switcher Chip -->
            <TextView
                android:id="@+id/chip_engine_mode"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Engine: Hybrid (Google + Instant)"
                android:textColor="@color/kb_accent"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Grid Scale / Columns Chip -->
            <TextView
                android:id="@+id/chip_grid_scale"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="⊞ 3x Grid"
                android:textColor="@color/kb_text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <!-- Fullscreen Height Toggle Chip -->
            <TextView
                android:id="@+id/chip_full_screen"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_inactive"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="⛶ Fullscreen"
                android:textColor="@color/kb_text_secondary"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Full-Screen Main Content Area: Image Grid + History Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_image_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp"
            android:scrollbars="vertical" />

        <!-- Status / Empty Prompt -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/tv_status_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Type below to search Google Images &amp; GIFs — or tap 🕒 for your search history!"
                android:textColor="@color/kb_text_secondary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Search History Overlay Panel (Toggled by the 🕒 button in the top bar) -->
        <LinearLayout
            android:id="@+id/history_panel_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_history_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Searches"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear_history"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Clear All"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/history_items_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Hidden 1x1 WebView container for Headless Google Images JS execution -->
        <FrameLayout
            android:id="@+id/headless_webview_holder"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0.0"
            android:importantForAccessibility="noHideDescendants" />
    </FrameLayout>

    <!-- Word Suggestion & Spell Check Strip (Appears directly above typing pad) -->
    <HorizontalScrollView
        android:id="@+id/suggestion_bar_scroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:scrollbars="none"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/suggestion_bar_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp" />
    </HorizontalScrollView>

    <!-- Scalable QWERTY / Numbers / Symbols Pad -->
    <LinearLayout
        android:id="@+id/container_mini_qwerty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="visible" />

    <!-- Dedicated Bottom Safe Clearance Spacer controlled directly by Bottom Bar Offset! -->
    <View
        android:id="@+id/bottom_nav_spacer"
        android:layout_width="match_parent"
        android:layout_height="54dp" />

</LinearLayout>
