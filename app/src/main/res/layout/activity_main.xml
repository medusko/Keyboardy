<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_screen_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_bg"
    android:orientation="vertical">

    <!-- Top App Bar (Matching Lagatron's TopAppBar: Title + Status Pill + Info Icon + Light/Dark Icon) -->
    <LinearLayout
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingTop="48dp"
        android:paddingBottom="14dp">

        <!-- Title + Status Badge Row -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Keyboardy"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Lagatron-style Status Pill (ENABLED / SETUP) -->
            <LinearLayout
                android:id="@+id/status_pill_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp">

                <View
                    android:id="@+id/status_pill_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp" />

                <TextView
                    android:id="@+id/tv_status_pill_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="ENABLED"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Info Button (About Keyboardy Dialog) -->
        <ImageButton
            android:id="@+id/btn_about_info"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="About Keyboardy"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_info" />

        <!-- Light / Dark Theme Icon Button (Sun in Dark Mode, Moon in Light Mode — matching Lagatron) -->
        <ImageButton
            android:id="@+id/btn_toggle_theme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Toggle Light/Dark Theme"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_light_mode" />
    </LinearLayout>

    <!-- Thin TopAppBar Divider -->
    <View
        android:id="@+id/top_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E3342" />

    <ScrollView
        android:id="@+id/root_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="36dp">

            <!-- ==================== SECTION 1: ENABLEMENT ==================== -->
            <TextView
                android:id="@+id/tv_section_enablement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="ENABLEMENT"
                android:textColor="#2E6BD9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Card 1: Setup Auxiliary Keyboard (Collapsible when already enabled) -->
            <LinearLayout
                android:id="@+id/card_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/setup_header_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_ime_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auxiliary Keyboard Setup"
                        android:textColor="#2E6BD9"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_setup_chevron"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="▼"
                        android:textColor="#B8C2D4"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/setup_collapsible_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_setup_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Keep your default keyboard as your main keyboard! Enable Keyboardy in Android Settings so it is available whenever you want to search and insert images or GIFs."
                        android:textColor="#B8C2D4"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_enable_ime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#2E6BD9"
                        android:text="Enable in Settings"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: Live Chat Test Sandbox -->
            <LinearLayout
                android:id="@+id/card_sandbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_sandbox_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Chat Test Sandbox"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_sandbox_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tap the input box below, switch to Keyboardy, search &amp; tap an image. It will insert right here via Android's CommitContent API!"
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/sandbox_received_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/iv_sandbox_received"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:contentDescription="Inserted Image"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/tv_sandbox_received_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Inserted via commitContent!"
                        android:textColor="#00C853"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_chat_sandbox"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:hint="Tap here to test Keyboardy..."
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ==================== SECTION 2: CUSTOMIZATION ==================== -->
            <TextView
                android:id="@+id/tv_section_customization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="CUSTOMIZATION"
                android:textColor="#2E6BD9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Card 3: Keyboard Scale & Bottom Bar Clearance -->
            <LinearLayout
                android:id="@+id/card_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_scale_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keyboard Size &amp; Bottom Bar Clearance"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_scale_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Scale up the typing keys while the image results fill the rest of the screen. Use − 4 / + 4 to raise or lower the keyboard from the bottom edge."
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <!-- 4 Scale Option Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_scale_compact"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="100%"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_scale_normal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="115%"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_scale_large"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="130%"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_scale_xlarge"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="145% XL"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Bottom Navigation Clearance Stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_bottom_clearance_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bottom Bar Offset: 38dp"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_clearance_minus"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:text="− 4"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_clearance_plus"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:text="+ 4"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3B: Thumbnail & Grid Density Scale -->
            <LinearLayout
                android:id="@+id/card_grid_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_grid_scale_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thumbnail Scale &amp; Columns (Break 3x Grid)"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_grid_scale_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Scale thumbnails up to view full-width uncropped images, or scale down for compact browsing. Break out of the rigid 3-column grid anytime."
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <!-- 4 Column Option Buttons: 1x, 2x, 3x, 4x -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_grid_1col"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1x Feed"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_grid_2col"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="2x Large"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_grid_3col"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="3x Grid"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_grid_4col"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="4x Compact"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card: App Launcher Icon Selection -->
            <LinearLayout
                android:id="@+id/card_app_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_app_icon_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Launcher Icon"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_app_icon_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Select your home screen launcher icon. Changes take effect on your launcher immediately."
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- Gold Icon Option -->
                    <LinearLayout
                        android:id="@+id/btn_icon_gold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_icon_gold_preview"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_app_gold" />

                        <TextView
                            android:id="@+id/tv_icon_gold_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Gold (Default)"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_icon_gold_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="RC2"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Classic Icon Option -->
                    <LinearLayout
                        android:id="@+id/btn_icon_classic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_icon_classic_preview"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_app_classic" />

                        <TextView
                            android:id="@+id/tv_icon_classic_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Classic"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_icon_classic_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Original"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 4: Search Behavior Preferences -->
            <LinearLayout
                android:id="@+id/card_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_settings_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Behavior"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cb_auto_return_gboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:text="Auto-switch back to default keyboard after inserting image"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_auto_read_chat_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Use written chat text as auto-search when opening Keyboardy (Off = every search starts blank)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_nsfw_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="Unfiltered Mode (turns off SafeSearch filtering on Google Images &amp; Instant Web)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cb_full_screen_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="false"
                    android:text="Full Screen Mode (expands Keyboardy to fill the entire display height for maximum image viewing)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ==================== SECTION 3: HELP ==================== -->
            <TextView
                android:id="@+id/tv_section_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:text="HELP"
                android:textColor="#2E6BD9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Card 5: Dedicated Standalone Section — What the Image Badges Mean -->
            <LinearLayout
                android:id="@+id/card_badges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_badges_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What the Image Badges Mean"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_badges_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Each thumbnail in the search grid shows a corner badge indicating its source and format:"
                    android:textColor="#B8C2D4"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/badge_legend_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_badge_legend_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="⚡  Thunderbolt Badge (Instant Web Search)\nFetched via our ultra-fast async HTTP engine in ~150ms so high-res images &amp; Tenor/Giphy GIFs appear immediately.\n\nG  Google Badge (Headless Google WebView)\nFetched via an invisible background WebView querying Google Images (udm=2) directly on your phone.\n\nB  API Badge (Optional Brave / SerpApi)\nFetched via your custom API key if configured below.\n\nGIF  Top-Left Badge (Animated GIF)\nIndicates a looping animated GIF that plays inside the grid and inserts as an animation in your chat."
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 6: Search Usage, Quotas, & Optional API Key -->
            <LinearLayout
                android:id="@+id/card_quota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_quota_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search Usage, Quotas, &amp; Optional API Key"
                    android:textColor="#2E6BD9"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Quantified Live Usage Box -->
                <LinearLayout
                    android:id="@+id/quota_stats_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_quota_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="Searches Today: 0  •  This Month: 0\nImages Inserted Today: 0 (0 search quota used)"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_quota_tier_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Active Mode: Built-in Free Hybrid (G + ⚡) — Unlimited ($0)\nNote: Quotas are counted strictly PER SEARCH QUERY, never per image tapped! Tapping images/GIFs downloads directly from the host and uses 0 search quota."
                        android:textColor="#B8C2D4"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Why Use an Optional API Key Explanation -->
                <TextView
                    android:id="@+id/tv_why_api_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Why might someone want to use an API Key?"
                    android:textColor="#2E6BD9"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_api_key_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="The built-in Hybrid engine is 100% free and unlimited, so most users never need a key. However, if you use a heavy VPN or shared corporate Wi-Fi, Google's public web search can occasionally serve temporary IP CAPTCHAs. Adding a free Brave Search API key (2,000 free searches/month) or SerpApi key (100 free searches/month) bypasses web CAPTCHAs completely and fetches direct JSON in a single call."
                    android:textColor="#B8C2D4"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/et_optional_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:hint="Optional Brave or SerpApi Key (Leave blank for Free Hybrid)"
                    android:inputType="textNoSuggestions"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_save_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2E6BD9"
                    android:text="Save API Key"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
